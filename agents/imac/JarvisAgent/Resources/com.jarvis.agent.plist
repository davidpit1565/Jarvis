<?xml version="1.0" encoding="UTF-8"?>
<!--
Template for the launchd user agent. Don't install this file directly —
scripts/install.sh substitutes __JARVIS_AGENT_EXECUTABLE__ and writes the
result to ~/Library/LaunchAgents/com.jarvis.agent.plist, because launchd
does not expand $HOME and the Agent must be run from inside its .app
bundle.

RunAtLoad + KeepAlive give the persistence Phase 2 requires: the Agent
starts at login and is restarted by launchd if it crashes, without
needing a Terminal window open.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jarvis.agent</string>

    <key>ProgramArguments</key>
    <array>
        <string>__JARVIS_AGENT_EXECUTABLE__</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ProcessType</key>
    <string>Interactive</string>

    <key>StandardOutPath</key>
    <string>/tmp/jarvis-agent.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/jarvis-agent.err.log</string>
</dict>
</plist>
