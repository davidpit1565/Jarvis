<?xml version="1.0" encoding="UTF-8"?>
<!--
REQUIRES REAL macOS VALIDATION — this launchd user agent definition has
never been loaded or tested on a real Mac. Install to:
  ~/Library/LaunchAgents/com.jarvis.agent.plist
then:
  launchctl load ~/Library/LaunchAgents/com.jarvis.agent.plist

RunAtLoad + KeepAlive give the persistence Phase 2 requires: the Agent
starts at login and is restarted by launchd if it crashes, without
needing a Terminal window open.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jarvis.agent</string>

    <key>ProgramArguments</key>
    <array>
        <!-- Replace with the actual installed path of the built executable. -->
        <string>/usr/local/bin/JarvisAgent</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ProcessType</key>
    <string>Interactive</string>

    <key>StandardOutPath</key>
    <string>/tmp/jarvis-agent.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/jarvis-agent.err.log</string>
</dict>
</plist>
