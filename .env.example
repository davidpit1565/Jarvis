# Which Brain implementation src/index.ts constructs: "anthropic" (default,
# unset means this) or "groq" — a genuine $0 option added on explicit
# request (Groq's free tier: no credit card, real tool-calling support,
# verified live during development). Read the honest quality-tradeoff
# note under GROQ_API_KEY below before switching — this is NOT a drop-in
# replacement for real Claude quality.
JARVIS_BRAIN_PROVIDER=

# Anthropic API key used by the Claude Brain. Required unless
# JARVIS_BRAIN_PROVIDER=groq. Never commit the real value.
ANTHROPIC_API_KEY=

# Required when JARVIS_BRAIN_PROVIDER=groq (ignored otherwise). Get a free
# key at https://console.groq.com/keys — no credit card. This is the
# genuinely-free-of-charge path: with JARVIS_BRAIN_PROVIDER=groq and only
# this key set, JARVIS never talks to Anthropic's API at all, so nothing
# here costs money. Real tradeoff, not a free lunch: JARVIS's tool-calling
# reliability, personality, and Hebrew/English handling are tuned against
# real Claude models — Groq's free-tier Llama models are capable but will
# noticeably follow instructions and use tools less reliably. Worth
# testing directly rather than assuming it behaves the same as Claude.
GROQ_API_KEY=

# Optional: overrides GroqBrain's own default model
# (llama-3.3-70b-versatile — a real tool-calling-capable free-tier model).
# Ignored unless JARVIS_BRAIN_PROVIDER=groq.
JARVIS_GROQ_MODEL=

# Second, independent free-tier provider alongside Groq. Registered
# automatically at startup whenever this is set — see src/index.ts. When
# Groq hits its daily quota (429), AIRouter falls back here on its own.
# Get a key at https://openrouter.ai/keys — no credit card needed for the
# ":free" models this provider is restricted to.
OPENROUTER_API_KEY=

# Optional: overrides OpenRouterBrain's default
# (nvidia/nemotron-3-ultra-550b-a55b:free). Must carry OpenRouter's ":free"
# suffix — the provider refuses to construct against a paid model, so a
# typo here disables OpenRouter rather than quietly starting to bill.
# OpenRouter does withdraw models from its free tier (that is what happened
# to the previous default), and the suffix check cannot catch that: a
# withdrawn id still constructs and then 404s on every call.
JARVIS_OPENROUTER_MODEL=

# Third/fourth free-tier provider: a user-run Ollama server
# (https://ollama.com) — software you install and start yourself
# (`ollama serve`), never a hosted account JARVIS signs up for. This one
# server config is shared by two independent, separately-gated features:
# the OllamaBrain chat provider (gated on OLLAMA_MODEL — see below) and the
# OllamaEmbeddingsClient used for optional local semantic memory/caching
# (gated on OLLAMA_EMBEDDING_MODEL, further down). Defaults to
# "http://localhost:11434" (Ollama's own default port), but that default
# only resolves to wherever JARVIS's own backend process is running — if
# that's a cloud host (e.g. Fly.io) and Ollama runs on your own Mac, set
# this to a network address JARVIS's backend can actually reach (e.g. a
# Tailscale/ngrok address) instead. See README's Ollama section.
OLLAMA_BASE_URL=http://localhost:11434

# Required to actually register OllamaBrain as a chat provider: the model
# id you've already pulled locally (`ollama pull <model>`), e.g. "qwen2.5",
# "gpt-oss", "llama3.3". Deliberately has no default — JARVIS has no way to
# guess which model (if any) you've pulled, and defaulting it would risk
# pointing at a model that was never downloaded. Unset means Ollama chat
# support is simply inactive, exactly like an unconfigured Groq/OpenRouter
# key.
OLLAMA_MODEL=

# Optional: bearer token for a proxied Ollama setup (e.g. behind a reverse
# proxy that adds its own auth). Ollama's own default local setup has no
# authentication at all, so this is never required and OllamaBrain never
# sends an Authorization header when it's unset.
OLLAMA_API_KEY=

# Fourth/fifth free-tier provider: Cloudflare Workers AI, a real hosted
# service (unlike Ollama above), so all three of the following are always
# required together to register CloudflareWorkersAIBrain — there is no
# sensible default to fall back to, and a partially-configured setup stays
# fully inert rather than half-working. CLOUDFLARE_ACCOUNT_ID is visible on
# any zone/account overview page in the Cloudflare dashboard.
# CLOUDFLARE_API_TOKEN needs "Workers AI" read/edit permission, created
# under My Profile > API Tokens. CLOUDFLARE_MODEL is a model id from
# Cloudflare's model catalog (e.g. "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
# — see https://developers.cloudflare.com/workers-ai/models/ for the full
# list of 50+ hosted models); deliberately has no default since Cloudflare
# hosts far too many models, with different capabilities, to guess a
# universally-correct one.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=

# Sixth, independent free-tier provider. Get a free API key (no credit
# card) at https://aistudio.google.com/apikey. Registered automatically at
# startup whenever this is set — see src/index.ts.
GEMINI_API_KEY=

# Optional: overrides GeminiBrain's own default (gemini-2.0-flash — a
# best-effort pick, not independently verified against Google's current
# free-tier model list; see GeminiBrain's own doc comment).
JARVIS_GEMINI_MODEL=

# --- AIRouter: free-first routing across whichever providers above are ---
# --- actually configured (both ANTHROPIC_API_KEY and GROQ_API_KEY can ---
# --- be set at once now — see src/core/brain/AIRouter.ts) ---

# Whether AIRouter prefers a free-tier provider (Groq/OpenRouter/Ollama/
# Cloudflare/Gemini) over a paid one (Anthropic) when JARVIS_BRAIN_PROVIDER
# is left unset and more than one provider is configured. Defaults to
# FALSE — Claude is the real default primary; free providers are a
# cost-saving fallback, not the default. (This was flipped from an earlier
# `true` default: that silently routed a plain "ANTHROPIC_API_KEY + a free
# key, nothing else touched" deployment to a free, weaker provider by
# default — see README's "AIRouter: free-first routing" section.) Set to
# "true" to explicitly opt into free-first behavior. Has no effect when
# JARVIS_BRAIN_PROVIDER is explicitly set — an explicit choice always wins
# as the primary provider; this only ever matters when no explicit choice
# was made. So an existing deployment with JARVIS_BRAIN_PROVIDER already
# set sees zero behavior change from this.
AI_FREE_FIRST=

# Optional: which provider ("anthropic" or "groq") AIRouter retries
# against when the primary provider's call fails (network error, 5xx,
# rate limit) or a budget cap below blocks it. Unset means AIRouter still
# falls back to whichever *other* provider happens to be configured, if
# any — this only lets you pin exactly which one. With only one provider
# configured there is nothing to fall back to, and the original error is
# what the caller sees, same as before AIRouter existed.
AI_FALLBACK_PROVIDER=

# Optional override for the order AIRouter prefers among configured
# free-tier providers (used for the free-first primary pick, and as the
# fallback target on a budget cap / ZERO_COST_MODE swap) — see
# AIRouter.ts's DEFAULT_FREE_PROVIDER_PRIORITY doc comment. Defaults to
# "gemini,openrouter,cloudflare-workers-ai,groq" (Gemini generally has the
# strongest free-tier model quality of the options here; Groq is kept last
# as a fallback only — not rated highly for quality, but still genuinely
# free). Comma-separated provider names, highest priority first, e.g.
# "gemini,groq,openrouter". Unset means the built-in default above.
FREE_PROVIDER_PRIORITY=

# Optional daily/monthly USD caps on *estimated* paid-provider (Anthropic)
# spend, tracked by CostTracker (src/core/cost/CostTracker.ts, a small
# SQLite log of every call's approximate cost — see the honesty caveat in
# its own comments about how approximate that estimate is). Once a cap is
# met, AIRouter refuses to call a paid provider for that request: it uses
# a free provider instead if one is configured, or throws a clear
# "budget exceeded" error if not — it never just silently keeps charging,
# and never silently drops the request either. Unset (both, or either) is
# unlimited, the default.
MAX_DAILY_COST_USD=
MAX_MONTHLY_COST_USD=

# Hard zero-cost boundary. When true, AIRouter will NEVER call a paid
# provider — not as a fallback when the free provider fails, not for any
# reason. This is stricter than and independent of MAX_DAILY_COST_USD/
# MAX_MONTHLY_COST_USD above: those bound how much a paid provider may be
# used, this forbids using one at all. If no free-tier provider is
# configured, or the free provider fails and there's no other free
# provider to try, AIRouter throws a clear ZeroCostModeError explaining
# exactly why chat is unavailable right now — it never silently falls
# through to Anthropic. Defaults to false.
ZERO_COST_MODE=

# Denial-of-wallet protection: optional hard USD ceiling on estimated
# paid-provider spend within a single run (one conversation turn or one
# AgentCore task). Once reached, further paid-provider calls *for that same
# run* fall back to a free provider (or fail clearly if none is configured)
# — independent of and stricter-scoped than MAX_DAILY_COST_USD/
# MAX_MONTHLY_COST_USD above, which only bound spend in aggregate. Unset
# means unlimited (today's behavior).
JARVIS_MAX_COST_PER_RUN_USD=

# Optional: budget-constrained degradation. Once today's or this month's
# spend reaches this fraction of MAX_DAILY_COST_USD/MAX_MONTHLY_COST_USD
# (e.g. 0.8 = 80%), AIRouter proactively biases toward a free provider even
# though the hard cap hasn't been hit yet — a soft nudge, not a new hard
# boundary. Defaults to 0.8; a value >= 1 disables the feature (routing
# only reacts at the hard cap). Ignored entirely when neither cost cap
# above is configured.
JARVIS_SOFT_BUDGET_CAP_RATIO=0.8

# Optional: how many consecutive failed calls to a provider before
# AIRouter's circuit breaker opens for it — routing skips that provider
# entirely (as if unconfigured) until AI_CIRCUIT_BREAKER_COOLDOWN_MS below
# has passed, then lets one trial call through before deciding whether to
# close the circuit again (success) or re-open it (failure). This is the
# same mechanism regardless of which provider is "free" vs "paid" — it
# keys off call outcomes, not provider identity. Defaults to 3.
AI_CIRCUIT_BREAKER_THRESHOLD=

# Optional: how long (ms) a provider's circuit stays open before the next
# half-open trial call is allowed. Defaults to 60000 (60s).
AI_CIRCUIT_BREAKER_COOLDOWN_MS=

# Path to the SQLite database storing AIRouter's per-call estimated-cost
# records (CostTracker).
JARVIS_AI_COST_DB_PATH=./data/jarvis-ai-cost.sqlite

# Optional: enables Anthropic prompt caching (cache_control: ephemeral) on
# the system prompt and tool definitions ClaudeBrain sends. A pure cost
# optimization with no behavior change, so it defaults to TRUE; set to
# "false" only to rule it out while debugging a cost/usage discrepancy.
JARVIS_PROMPT_CACHING=true

# Optional: TTL (ms) for the in-memory READ-tool result cache
# (ToolResultCache) — how long an identical READ-tool call's result is
# served from cache instead of re-running the tool (e.g. a repeated
# GET_WEATHER for the same location). 0 disables the cache entirely.
# Defaults to 60000 (60s).
JARVIS_TOOL_RESULT_CACHE_TTL_MS=60000

# Optional: whether the background memory-extraction pass (Continuous
# Memory/Profile) runs after each conversation turn. Defaults to TRUE —
# on by default since it's fire-and-forget, best-effort, and already
# respects ZERO_COST_MODE/budget caps the same way every other Brain call
# does. Set to "false" to turn it off entirely (e.g. to eliminate the
# extra per-turn Brain call altogether, not just cap its cost).
JARVIS_MEMORY_EXTRACTION_ENABLED=true

# Optional: overrides the Anthropic API base URL — an explicit opt-in only,
# for pointing JARVIS's brain at a local Anthropic-compatible model
# gateway (e.g. a self-hosted router that proxies to free/cheaper models)
# instead of Anthropic's own metered API, to cut cost. Unset (the default)
# always means the real Anthropic API. Read this carefully before setting
# it: a gateway that substitutes a different, weaker model for "Claude"
# can noticeably hurt tool-calling reliability, personality, and Hebrew
# quality, since JARVIS's behavior is tuned against real Claude models —
# and the token-usage cost estimate in GET /status stops being accurate
# once requests aren't actually billed at Anthropic's own rates. This is
# NEVER read from the ambient ANTHROPIC_BASE_URL env var some other local
# tool might set — only from this JARVIS-specific one.
JARVIS_ANTHROPIC_BASE_URL=

# Optional: a cheaper/different model (e.g. a Haiku model ID) to retry
# against, once, if the primary model call fails with a 429/503/529 even
# after the SDK's own automatic retries — a degraded reply beats no reply
# during a provider outage or rate-limit spike. Unset means never fall
# back, ever.
JARVIS_FALLBACK_MODEL=

# Optional: the public base URL this server is reachable at, used for the
# Google Calendar OAuth redirect URI. Separate from TWILIO_PUBLIC_BASE_URL
# below — you can enable Calendar integration without the phone gateway
# (or vice versa) — even though in practice they're often the same URL.
JARVIS_PUBLIC_BASE_URL=

# Optional: enables Google Calendar (read/write) AND Gmail (read-only
# search) integration together, from one linked account — both required
# together, plus JARVIS_PUBLIC_BASE_URL and JARVIS_ADMIN_TOKEN above/below.
# Create these in Google Cloud Console: a project with the Calendar API
# enabled, an OAuth consent screen, and an OAuth 2.0 Client ID (type "Web
# application") whose authorized redirect URI is exactly
# "<JARVIS_PUBLIC_BASE_URL>/calendar/oauth/callback". See README.md
# "Calendar & Gmail integration" for the full walkthrough.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Path to the SQLite database storing the linked Google account's OAuth
# tokens (only meaningful once Calendar integration above is configured).
JARVIS_CALENDAR_TOKEN_DB_PATH=./data/jarvis-calendar-tokens.sqlite

# Optional: enables Spotify playback control (play/pause/skip/what's
# playing) — both required together, plus JARVIS_PUBLIC_BASE_URL and
# JARVIS_ADMIN_TOKEN above/below. Create these at
# https://developer.spotify.com/dashboard — a new app whose Redirect URI
# is exactly "<JARVIS_PUBLIC_BASE_URL>/spotify/oauth/callback". See
# README.md "Spotify integration" for the full walkthrough.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Path to the SQLite database storing the linked Spotify account's OAuth
# tokens (only meaningful once Spotify integration above is configured).
JARVIS_SPOTIFY_TOKEN_DB_PATH=./data/jarvis-spotify-tokens.sqlite

# Optional: enables the Canva Connect API integration (Design/Export/
# Asset/Autofill/Brand Template APIs) — both required together, plus
# JARVIS_PUBLIC_BASE_URL and JARVIS_ADMIN_TOKEN above/below. Create these
# at https://www.canva.com/developers/ — a new integration whose Redirect
# URI is exactly "<JARVIS_PUBLIC_BASE_URL>/canva/oauth/callback".
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# Path to the SQLite database storing the linked Canva account's OAuth
# tokens (only meaningful once Canva integration above is configured).
JARVIS_CANVA_TOKEN_DB_PATH=./data/jarvis-canva-tokens.sqlite

# Optional: a GitHub fine-grained personal access token (read-only scopes:
# repo contents, issues, pull requests) — David's own GitHub account.
# Unlike Calendar/Gmail/Spotify/Canva, there's no OAuth flow here: this
# single static token is all GitHubClient needs, for both on-demand
# GITHUB_* tools and the proactive GitHub-activity watcher below.
GITHUB_TOKEN=

# Optional: comma-separated "owner/repo" entries (e.g.
# "davidpit1565/Jarvis,davidpit1565/Rudder") to proactively poll for new
# commits/issues/PRs and surface unprompted at conversation start. Empty
# (the default) makes the proactive-surfacing feature inert — no polling,
# no note, not an error — the safe default rather than polling every repo
# GITHUB_TOKEN can see. Requires GITHUB_TOKEN above.
GITHUB_WATCHED_REPOS=

# Optional: when "true", the proactive GitHub poller auto-discovers and
# watches every repo you OWN (affiliation=owner only — never a repo you
# merely collaborate on or an org repo you can just read), unioned with
# whatever GITHUB_WATCHED_REPOS also lists. Re-resolved every poll cycle,
# so a repo created after startup is picked up automatically. Defaults to
# false. Requires GITHUB_TOKEN above.
GITHUB_WATCH_ALL_OWN_REPOS=false

# Path to the SQLite database caching each watched repo's poll cursor and
# most-recently-found new activity (GitHubActivityStore).
JARVIS_GITHUB_ACTIVITY_DB_PATH=./data/jarvis-github-activity.sqlite

# Optional: how often (ms) the background GitHub activity poller ticks.
# Only relevant when GITHUB_WATCHED_REPOS/GITHUB_WATCH_ALL_OWN_REPOS is
# active. Defaults to 1200000 (20 minutes).
JARVIS_GITHUB_ACTIVITY_POLL_MS=1200000

# Optional: comma-separated topics/keywords to proactively watch the
# configured news RSS feed (JARVIS_NEWS_RSS_URL above) for and surface
# unprompted — the generalized Proactive Watcher's news source. Empty (the
# default) makes news watching inert — no polling, no note — never an
# open-ended "watch everything in the feed" default. Only takes effect
# when JARVIS_NEWS_RSS_URL is also configured.
NEWS_WATCH_TOPICS=

# Path to the SQLite database caching each watched news topic's poll
# cursor and most-recently-found new headlines (the shared WatcherStore).
JARVIS_NEWS_WATCH_DB_PATH=./data/jarvis-news-watch.sqlite

# Optional: how often (ms) the background news-watch poller ticks. Only
# relevant when NEWS_WATCH_TOPICS is non-empty. Defaults to 1200000
# (20 minutes).
JARVIS_NEWS_WATCH_POLL_MS=1200000

# Optional: comma-separated raw Gmail search queries (e.g.
# "from:someone@example.com,subject:invoice") to proactively watch for new
# matching messages — the generalized Proactive Watcher's Gmail source.
# Empty (the default) makes Gmail watching inert — no polling, no note,
# never an open-ended "watch the whole inbox" default. Only takes effect
# once a Google account is linked for Gmail (GOOGLE_CLIENT_ID/SECRET
# above). Each query is its own watch source ("gmail:<query>").
GMAIL_WATCH_QUERIES=

# Path to the SQLite database caching each watched Gmail query's poll
# cursor and most-recently-found new messages (the shared WatcherStore).
JARVIS_GMAIL_WATCH_DB_PATH=./data/jarvis-gmail-watch.sqlite

# Optional: how often (ms) the background Gmail-watch poller ticks. Only
# relevant when GMAIL_WATCH_QUERIES is non-empty. Defaults to 1200000
# (20 minutes).
JARVIS_GMAIL_WATCH_POLL_MS=1200000

# Optional: comma-separated watch-source ids (exact match, e.g.
# "news:ai safety", "github:owner/repo") you've explicitly flagged as
# warranting the louder device-announce channel instead of the default
# quiet Telegram note — see WatcherChannelRouter's own doc comment for why
# this is config, never a per-item model judgment call. Empty by default:
# every source stays on the default Telegram channel until explicitly
# escalated.
WATCHER_HIGH_PRIORITY_SOURCES=

# Optional: the device id WatcherNotifier speaks a high-priority watcher
# notification on — required for the device-announce channel to actually
# fire (otherwise it falls back to Telegram, never silently drops).
WATCHER_ANNOUNCE_DEVICE_ID=

# Optional: whether a watcher poll finding new activity should also send
# an immediate notification, not just cache it for the next conversation's
# context note. Defaults to false: with it off, activity surfaces only at
# the start of the next conversation. Opt-in because an immediate push is
# a real behavior change (an unprompted Telegram message can arrive at any
# time of day).
WATCHER_PUSH_NOTIFICATIONS_ENABLED=false

# Optional: whether JARVIS's self-improvement suggestion watcher (a small,
# hand-curated static candidate list — see selfImprovementCandidates.ts)
# runs at all. Unlike every other Proactive Watcher source above, this one
# defaults to TRUE, not opt-in-empty — it reads only a static, in-repo
# list (no external account/data access, no new privacy surface). Set to
# "false" to opt out.
SELF_IMPROVEMENT_WATCH_ENABLED=true

# Path to the SQLite database caching the self-improvement watcher's
# rotation cursor and most-recently-surfaced candidate (the shared
# WatcherStore).
JARVIS_SELF_IMPROVEMENT_DB_PATH=./data/jarvis-self-improvement-watch.sqlite

# Optional: how often (ms) the self-improvement watcher polls. Defaults to
# 604800000 (7 days) — deliberately much slower than news/GitHub's
# 20-minute default, since it watches a small, hand-curated static list
# rather than a fast-changing external source.
SELF_IMPROVEMENT_POLL_MS=604800000

# Optional: enables the video studio integration (list rendered reels,
# publish to Instagram/Facebook, read Instagram stats) — both required
# together. JARVIS_STUDIO_BASE_URL is the studio's own deployed URL
# (e.g. https://actually-works.com); JARVIS_STUDIO_SECRET must match the
# JARVIS_STUDIO_SECRET env var set on the studio's own deployment. See
# README.md "Video studio integration" for the full walkthrough.
JARVIS_STUDIO_BASE_URL=
JARVIS_STUDIO_SECRET=

# Port the JARVIS Core HTTP/WebSocket server listens on.
JARVIS_PORT=4770

# Path to the local SQLite memory database.
JARVIS_MEMORY_DB_PATH=./data/jarvis-memory.sqlite

# Path to the SQLite database storing registered Face ID / Touch ID
# (WebAuthn) credentials for the dashboard.
JARVIS_WEBAUTHN_DB_PATH=./data/jarvis-webauthn.sqlite

# Path to the SQLite database storing reminders/tasks.
JARVIS_REMINDERS_DB_PATH=./data/jarvis-reminders.sqlite

# Path to the SQLite database storing the shared confirmation passphrase
# (ConfirmationPassphraseStore/SpeakerAuthenticator) — the security layer
# for proactive "wake up and speak" reminders: a spoken reply to one of
# those is only treated as really the owner once it matches this
# passphrase. Separate from reminders' own database so it survives/rotates
# independently.
JARVIS_CONFIRMATION_PASSPHRASE_DB_PATH=./data/jarvis-confirmation-passphrase.sqlite

# Optional: seed value for the confirmation passphrase above — only used to
# initialize the store the first time it's empty (e.g. on a fresh deploy);
# once set (via this or the SET_CONFIRMATION_PASSPHRASE tool), the stored
# value always wins over this env var on subsequent starts. Never commit
# the real value.
JARVIS_CONFIRMATION_PASSPHRASE=

# Path to the SQLite database storing proactive automation rules (JARVIS
# acting on its own by a schedule).
JARVIS_AUTOMATION_RULES_DB_PATH=./data/jarvis-automation-rules.sqlite

# Path to the SQLite database storing tracked commitments/promises
# (CommitmentStore).
JARVIS_COMMITMENTS_DB_PATH=./data/jarvis-commitments.sqlite

# Optional: how many days an open commitment can go without being
# fulfilled before the follow-up engine marks it "stale" and it starts
# surfacing as proactive context. Defaults to 3.
JARVIS_STALE_COMMITMENT_DAYS=3

# Path to the SQLite database storing Goal Engine goal records (GoalStore)
# — CREATE_GOAL/CHECK_GOAL_PROGRESS/COMPLETE_GOAL/CANCEL_GOAL.
JARVIS_GOALS_DB_PATH=./data/jarvis-goals.sqlite

# Path to the SQLite database storing behavioral corrections
# (BehaviorCorrectionStore) — Correction Learning.
JARVIS_BEHAVIOR_CORRECTIONS_DB_PATH=./data/jarvis-behavior-corrections.sqlite

# Path to the SQLite database storing Autonomous Agent Core task state
# (AgentTaskStore).
JARVIS_AGENT_TASK_DB_PATH=./data/jarvis-agent-tasks.sqlite

# Optional: how often (ms) the background agent queue worker's
# AgentCore.runQueueTick fires. Defaults to 5000 (5s).
JARVIS_AGENT_QUEUE_TICK_MS=5000

# Path to the SQLite database backing the dashboard's activity log, so
# recent activity survives a restart/redeploy instead of resetting to
# "Nothing yet." every time.
JARVIS_ACTIVITY_LOG_DB_PATH=./data/jarvis-activity.sqlite

# Path to the SQLite database storing the full conversation transcript
# (user/assistant text only), for the search_conversation_history tool.
JARVIS_CONVERSATION_HISTORY_DB_PATH=./data/jarvis-conversation-history.sqlite

# Path to the SQLite database storing paired-device credentials (hashed,
# never the plaintext) — without this, every restart would forget every
# approved device, forcing a full re-pair even though nothing changed.
JARVIS_PAIRING_DB_PATH=./data/jarvis-pairing.sqlite

# Path to the SQLite database storing device identity/role, so a device
# doesn't lose its assigned role (e.g. "primary") after a restart.
JARVIS_DEVICE_REGISTRY_DB_PATH=./data/jarvis-devices.sqlite

# Path to the SQLite database storing the structured tool-execution audit
# trail (tool name, exact input, who ran it, success/failure) — distinct
# from the dashboard's human-readable activity log.
JARVIS_TOOL_AUDIT_LOG_DB_PATH=./data/jarvis-tool-audit.sqlite

# Path to the SQLite database storing per-call Anthropic token usage
# (input/output/cache tokens), so GET /status can show real cumulative
# cost instead of you having to check the Anthropic console days later.
JARVIS_TOKEN_USAGE_DB_PATH=./data/jarvis-token-usage.sqlite

# Path to the SQLite database storing a durable record of proactive
# automation rule executions that threw (readable via
# GET /automation-failures), distinct from the transient activity-log
# entry and console line a failure also produces.
JARVIS_AUTOMATION_FAILURES_DB_PATH=./data/jarvis-automation-failures.sqlite

# Optional: your IANA timezone (e.g. "Asia/Jerusalem", "America/New_York").
# Defaults to UTC. Without this, Claude has no ground truth for "now" in
# your actual local time, so a reminder like "tomorrow at 9am" can't be
# reliably resolved to the right moment.
JARVIS_TIMEZONE=UTC

# Optional: both set together to suppress non-urgent proactive
# notifications (reminder due-notifications, automation-rule result
# pushes, the morning briefing) during these "HH:MM" 24-hour local bounds
# (in JARVIS_TIMEZONE), queuing them to fire once the window ends instead
# of interrupting you overnight. An overnight window (start > end, e.g.
# "22:00"-"07:00") is supported and expected. Time-critical channels —
# alarms and scheduled wake-up calls — deliberately do NOT check this at
# all. Unset (either or both) disables quiet hours entirely.
JARVIS_QUIET_HOURS_START=
JARVIS_QUIET_HOURS_END=

# Optional: Tool Risk Model — hard cap on how many tool calls a single
# Orchestrator turn will actually execute. Defaults to 30.
JARVIS_MAX_TOOL_CALLS_PER_RUN=30

# Optional: Tool Risk Model — default timeout (ms) for a local tool's
# execute() call before Orchestrator aborts it instead of waiting forever.
# 0 disables timeout enforcement. Defaults to 30000 (30s).
JARVIS_LOCAL_TOOL_TIMEOUT_MS=30000

# Optional: enables the Semantic Memory Search / Semantic Result Cache
# layer, local-only via a user-run Ollama server (see OLLAMA_BASE_URL
# above) — set to an embedding model actually pulled into Ollama (e.g.
# "nomic-embed-text" — run `ollama pull nomic-embed-text` first) to opt
# in. Unset (the default) means every existing exact-match code path
# (MemoryStore.search LIKE matching, ToolResultCache's exact-match cache)
# runs completely unchanged, with zero dependency on Ollama being
# installed or running at all. See README's "Semantic memory & caching
# (optional, local-only)" section.
OLLAMA_EMBEDDING_MODEL=

# Optional: both required together to enable the AgentMail integration
# (https://docs.agentmail.to) — JARVIS's own independent email inbox (e.g.
# jarvis@agentmail.to), completely separate from your personal Gmail
# account (GOOGLE_CLIENT_ID/SECRET, SEND_EMAIL). The inbox itself is
# created once in AgentMail's own dashboard/API; JARVIS only ever operates
# the one inbox id given here.
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=

# Optional: hard daily cap on real sends via SEND_AGENT_EMAIL — mirrors
# JARVIS_MAX_OUTBOUND_CALLS_PER_DAY's reasoning: nothing else stops a
# misconfigured automation rule (or a runaway agent loop) from sending an
# unbounded number of real emails under JARVIS's own identity in a day.
# Defaults to 20.
AGENTMAIL_MAX_SENDS_PER_DAY=20

# Optional: a commit SHA (or any build identifier) reported by GET /health,
# for confirming exactly which deployed commit is actually live. Nothing
# sets this automatically — set it yourself before deploying, e.g.:
#   fly secrets set JARVIS_COMMIT_SHA=$(git rev-parse HEAD)
JARVIS_COMMIT_SHA=

# Optional: enables real internet search (Anthropic's own server-side
# web_search tool — billed through this same ANTHROPIC_API_KEY, no separate
# vendor/account needed). Off by default.
JARVIS_WEB_SEARCH=false

# Optional: caps how many searches Claude may run in a single turn.
JARVIS_WEB_SEARCH_MAX_USES=5

# Optional: enables real URL reading (Anthropic's own server-side web_fetch
# tool — same account/billing as web_search above) so JARVIS can actually
# open and read a page's content, not just see a search snippet. Off by
# default.
JARVIS_WEB_FETCH=false

# Optional: caps how many URL fetches Claude may run in a single turn.
JARVIS_WEB_FETCH_MAX_USES=5

# Optional: live phone-call audio waveform on the dashboard, via Twilio
# Media Streams. Only meaningful when the phone gateway is configured.
# REAL EXTRA COST: Twilio bills Media Streams at ~$0.004/min on top of
# normal call minutes. Off by default.
JARVIS_AUDIO_WAVEFORM=false

# --- Optional: phone gateway (call JARVIS via Twilio) ---
# Both of the following must be set together, or neither. See README.md
# "Phone gateway (call JARVIS)" for full setup steps.

# Auth token from the Twilio console. Never commit the real value.
TWILIO_AUTH_TOKEN=

# The exact public HTTPS URL Twilio will call (e.g. https://jarvis-core.fly.dev
# or an ngrok URL). Required to verify Twilio's request signature.
TWILIO_PUBLIC_BASE_URL=

# Optional: comma-separated E.164 phone numbers allowed to call JARVIS
# (e.g. +15551234567,+15557654321). If unset, the phone gateway refuses to
# start at all (see TWILIO_ALLOW_OPEN_ACCESS below to intentionally allow
# any caller instead).
TWILIO_ALLOWED_CALLERS=

# Optional: set to "true" to intentionally run the phone gateway with no
# TWILIO_ALLOWED_CALLERS allowlist — anyone who calls the configured
# number reaches full JARVIS, including tools like SAVE_MEMORY and
# SEND_EMAIL. Leave unset/false unless you specifically want that.
TWILIO_ALLOW_OPEN_ACCESS=

# Optional: Twilio <Say> voice name. Defaults to "Polly.Matthew" (Amazon's
# Standard, non-Neural engine) — deliberately chosen for a more synthetic,
# machine-sounding voice rather than the more human-sounding Neural voices.
# See https://www.twilio.com/docs/voice/twiml/say/text-speech for other
# options, including newer (beta, opt-in) Generative voices if enabled on
# the account.
TWILIO_VOICE=

# Optional: Twilio <Say> voice for Hebrew replies. Defaults to
# "Google.he-IL-Standard-D" — Amazon Polly has no Hebrew voice at all, so
# Hebrew always goes through Twilio's Google TTS integration regardless of
# what TWILIO_VOICE above is set to. Standard, not WaveNet, for the same
# "sound like a machine, not a person" reason as TWILIO_VOICE above.
TWILIO_VOICE_HEBREW=

# Optional: SSML <prosody pitch>/<prosody rate> applied to every spoken
# line, to make JARVIS's phone voice sit lower and land more deliberately —
# quiet and deep, not a chirpy assistant. Defaults to "-15%" pitch, "92%"
# rate. Pitch only takes effect on Polly's Standard engine and Twilio's
# Google voices (both defaults above) — Neural voices silently ignore it.
TWILIO_VOICE_PITCH=
TWILIO_VOICE_RATE=

# Optional: language Twilio's <Gather> recognizes speech in on phone calls.
# Defaults to "multi" — real automatic Hebrew/English detection via
# Twilio's deepgram_nova-3 speech model (a genuine Twilio feature, per
# their docs, but never exercised against a live account by this project).
# If deepgram_nova-3 isn't available on your Twilio account, set this to a
# single BCP-47 code instead (e.g. "he-IL" or "en-US") to fall back to
# Twilio's older single-language recognition.
TWILIO_GATHER_LANGUAGE=

# Optional: enables outbound calls (currently: scheduled wake-up calls) —
# all three required together. TWILIO_ACCOUNT_SID is your Twilio Account
# SID (from the Twilio console); TWILIO_FROM_NUMBER is the Twilio phone
# number to call FROM (E.164, e.g. +15005550006); JARVIS_OWNER_PHONE_NUMBER
# is your own phone number to call (E.164). Distinct from the inbound
# phone gateway above: a Twilio account can receive calls without ever
# placing one. Real Twilio per-minute cost applies to every call placed.
TWILIO_ACCOUNT_SID=
TWILIO_FROM_NUMBER=
JARVIS_OWNER_PHONE_NUMBER=

# Path to the SQLite database storing recurring wake-up/scheduled-call
# times (only meaningful when the outbound-call settings above are set).
JARVIS_WAKEUP_CALL_DB_PATH=./data/jarvis-wakeup-calls.sqlite

# Optional: how many outbound Twilio calls (currently: scheduled wake-up
# calls) JARVIS will place per day, at most — Twilio bills per call, and
# nothing else stops a misconfigured wake-up call rule from placing an
# unbounded number of real, billed calls. Defaults to 10.
JARVIS_MAX_OUTBOUND_CALLS_PER_DAY=10

# Optional: hard daily cap on real sends via SEND_SMS — same reasoning as
# JARVIS_MAX_OUTBOUND_CALLS_PER_DAY above: nothing else stops a
# misconfigured automation rule (or a runaway agent loop) from sending an
# unbounded number of real, Twilio-billed text messages to your phone in a
# day. Defaults to 20.
JARVIS_MAX_SMS_PER_DAY=20

# Optional: enables a scoped Telegram integration — a JARVIS bot the user
# adds to specific chats, not "read all Telegram messages." Both required
# together. TELEGRAM_BOT_TOKEN comes from @BotFather (send it "/newbot").
# TELEGRAM_WEBHOOK_SECRET is any long random value you also pass as
# `secret_token` when calling Telegram's setWebhook API (a one-time manual
# call — see README.md "Telegram integration" for the full walkthrough);
# it's how POST /telegram/webhook verifies a request actually came from
# Telegram. TELEGRAM_ALLOWED_CHAT_IDS is a comma-separated allowlist of
# numeric chat IDs (like TWILIO_ALLOWED_CALLERS). If unset, the Telegram
# gateway refuses to start at all (see TELEGRAM_ALLOW_OPEN_ACCESS below
# to intentionally allow any chat instead).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_IDS=

# Optional: set to "true" to intentionally run the Telegram gateway with
# no TELEGRAM_ALLOWED_CHAT_IDS allowlist — anyone who finds and messages
# the bot reaches full JARVIS, including tools like SAVE_MEMORY and
# SEND_EMAIL. Leave unset/false unless you specifically want that.
TELEGRAM_ALLOW_OPEN_ACCESS=

# Optional: your own Telegram chat ID, so JARVIS has somewhere to push a
# proactive notification to (NOTIFY_USER — "tell me on my phone when...").
# Distinct from TELEGRAM_ALLOWED_CHAT_IDS above (which chats may talk TO
# JARVIS): this is specifically where JARVIS talks first, unprompted.
TELEGRAM_OWNER_CHAT_ID=

# Optional: the bot's own public @username (with or without the leading
# @), used only to build a https://t.me/<username> deep link for OPEN_CHAT
# ("open your chat") so a user on another channel (SMS, the Mac voice
# agent) can get a tappable/speakable link to this same Telegram chat.
# Find it in @BotFather. Requires TELEGRAM_BOT_TOKEN/WEBHOOK_SECRET above
# to actually be set too — otherwise the link would lead to a bot that
# can't reply.
TELEGRAM_BOT_USERNAME=

# Path to the SQLite database storing recurring alarms — CREATE_ALARM etc,
# a real alarm clock (Telegram notification, not a phone call). Only
# meaningful once TELEGRAM_BOT_TOKEN/WEBHOOK_SECRET and
# TELEGRAM_OWNER_CHAT_ID above are all set.
JARVIS_ALARM_DB_PATH=./data/jarvis-alarms.sqlite

# Optional: enables GET_WEATHER — a real, free (Open-Meteo, no API key)
# current-weather lookup for one fixed location. Both required together.
# Find your coordinates at https://www.latlong.net or similar.
JARVIS_WEATHER_LATITUDE=
JARVIS_WEATHER_LONGITUDE=

# Optional: enables GET_NEWS — free headlines from this one RSS feed URL
# (any real news site's RSS feed works, e.g. an RSS URL from a site you
# already read). No API key, no account.
JARVIS_NEWS_RSS_URL=

# Optional: enables a weekly usage/cost digest pushed to your phone via
# NOTIFY_USER's own Telegram delivery — both required together, and both
# TELEGRAM_BOT_TOKEN/WEBHOOK_SECRET and TELEGRAM_OWNER_CHAT_ID above must
# also be set. Day: 0=Sunday .. 6=Saturday. Time: 24-hour HH:MM, in
# JARVIS_TIMEZONE.
JARVIS_WEEKLY_DIGEST_DAY=
JARVIS_WEEKLY_DIGEST_TIME=

# Optional: sends a wellness check-in via NOTIFY_USER's Telegram delivery
# once this many hours pass with no interaction on any channel — needs
# the same Telegram setup as above. Unset disables the feature.
JARVIS_CHECKIN_AFTER_HOURS=

# Optional: sends a daily morning briefing (weather + today's calendar +
# due/overdue reminders) via NOTIFY_USER's Telegram delivery at this
# 24-hour HH:MM local time (in JARVIS_TIMEZONE) — needs the same Telegram
# setup as above. Each section is included only if it's configured and
# has something to report. Unset disables the feature.
JARVIS_MORNING_BRIEFING_TIME=

# Optional: warns (console + dashboard activity log) once cumulative
# estimated Claude API cost crosses 75%, 90%, and 100% of this USD value.
# All-time, not a monthly reset — see README.md "Real cost visibility".
JARVIS_COST_ALERT_THRESHOLD_USD=

# The single shared secret for everything that can act as you. Sent as the
# X-Jarvis-Admin-Token header on ordinary requests, or as ?token= on the two
# that can't carry a header: the ws:// upgrades for /chat and /observer (a
# browser WebSocket has no way to set one). Leaving it EMPTY does not mean
# "default deny" — it turns every one of these gates off, so treat an empty
# value as a deliberate choice, not a safe default.
#
# What it protects: /chat (a full conversation with tool access — i.e. the
# ability to drive your Mac), /observer (a live mirror of every conversation),
# GET /status, /memory, /backup, /audit-log, and POST /pairing/approve.
# Without it on /pairing/approve specifically, an attacker can register a fake
# device and self-approve it, since the pairing code is handed back to whoever
# asked for it.
#
# Core listens on every interface, not just loopback, so on a shared network
# "only my machine can reach it" is not true and being local is not treated as
# a credential. That is the point of the token: the hologram UI itself stays
# reachable without one (it has to be, so a phone can load it and be asked for
# the token), but nothing that acts on your behalf does.
#
# Set it to any long random value: `openssl rand -hex 32`.
JARVIS_ADMIN_TOKEN=
