# Anthropic API key used by the Claude Brain. Never commit the real value.
ANTHROPIC_API_KEY=

# Optional: overrides the Anthropic API base URL — an explicit opt-in only,
# for pointing JARVIS's brain at a local Anthropic-compatible model
# gateway (e.g. a self-hosted router that proxies to free/cheaper models)
# instead of Anthropic's own metered API, to cut cost. Unset (the default)
# always means the real Anthropic API. Read this carefully before setting
# it: a gateway that substitutes a different, weaker model for "Claude"
# can noticeably hurt tool-calling reliability, personality, and Hebrew
# quality, since JARVIS's behavior is tuned against real Claude models —
# and the token-usage cost estimate in GET /status stops being accurate
# once requests aren't actually billed at Anthropic's own rates. This is
# NEVER read from the ambient ANTHROPIC_BASE_URL env var some other local
# tool might set — only from this JARVIS-specific one.
JARVIS_ANTHROPIC_BASE_URL=

# Optional: the public base URL this server is reachable at, used for the
# Google Calendar OAuth redirect URI. Separate from TWILIO_PUBLIC_BASE_URL
# below — you can enable Calendar integration without the phone gateway
# (or vice versa) — even though in practice they're often the same URL.
JARVIS_PUBLIC_BASE_URL=

# Optional: enables read-only Google Calendar integration — both required
# together, plus JARVIS_PUBLIC_BASE_URL and JARVIS_ADMIN_TOKEN above/below.
# Create these in Google Cloud Console: a project with the Calendar API
# enabled, an OAuth consent screen, and an OAuth 2.0 Client ID (type "Web
# application") whose authorized redirect URI is exactly
# "<JARVIS_PUBLIC_BASE_URL>/calendar/oauth/callback". See README.md
# "Calendar integration" for the full walkthrough.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Path to the SQLite database storing the linked Google account's OAuth
# tokens (only meaningful once Calendar integration above is configured).
JARVIS_CALENDAR_TOKEN_DB_PATH=./data/jarvis-calendar-tokens.sqlite

# Port the JARVIS Core HTTP/WebSocket server listens on.
JARVIS_PORT=4770

# Path to the local SQLite memory database.
JARVIS_MEMORY_DB_PATH=./data/jarvis-memory.sqlite

# Path to the SQLite database storing registered Face ID / Touch ID
# (WebAuthn) credentials for the dashboard.
JARVIS_WEBAUTHN_DB_PATH=./data/jarvis-webauthn.sqlite

# Path to the SQLite database storing reminders/tasks.
JARVIS_REMINDERS_DB_PATH=./data/jarvis-reminders.sqlite

# Path to the SQLite database backing the dashboard's activity log, so
# recent activity survives a restart/redeploy instead of resetting to
# "Nothing yet." every time.
JARVIS_ACTIVITY_LOG_DB_PATH=./data/jarvis-activity.sqlite

# Path to the SQLite database storing the full conversation transcript
# (user/assistant text only), for the search_conversation_history tool.
JARVIS_CONVERSATION_HISTORY_DB_PATH=./data/jarvis-conversation-history.sqlite

# Path to the SQLite database storing paired-device credentials (hashed,
# never the plaintext) — without this, every restart would forget every
# approved device, forcing a full re-pair even though nothing changed.
JARVIS_PAIRING_DB_PATH=./data/jarvis-pairing.sqlite

# Path to the SQLite database storing device identity/role, so a device
# doesn't lose its assigned role (e.g. "primary") after a restart.
JARVIS_DEVICE_REGISTRY_DB_PATH=./data/jarvis-devices.sqlite

# Path to the SQLite database storing the structured tool-execution audit
# trail (tool name, exact input, who ran it, success/failure) — distinct
# from the dashboard's human-readable activity log.
JARVIS_TOOL_AUDIT_LOG_DB_PATH=./data/jarvis-tool-audit.sqlite

# Path to the SQLite database storing per-call Anthropic token usage
# (input/output/cache tokens), so GET /status can show real cumulative
# cost instead of you having to check the Anthropic console days later.
JARVIS_TOKEN_USAGE_DB_PATH=./data/jarvis-token-usage.sqlite

# Optional: your IANA timezone (e.g. "Asia/Jerusalem", "America/New_York").
# Defaults to UTC. Without this, Claude has no ground truth for "now" in
# your actual local time, so a reminder like "tomorrow at 9am" can't be
# reliably resolved to the right moment.
JARVIS_TIMEZONE=UTC

# Optional: a commit SHA (or any build identifier) reported by GET /health,
# for confirming exactly which deployed commit is actually live. Nothing
# sets this automatically — set it yourself before deploying, e.g.:
#   fly secrets set JARVIS_COMMIT_SHA=$(git rev-parse HEAD)
JARVIS_COMMIT_SHA=

# Optional: enables real internet search (Anthropic's own server-side
# web_search tool — billed through this same ANTHROPIC_API_KEY, no separate
# vendor/account needed). Off by default.
JARVIS_WEB_SEARCH=false

# Optional: caps how many searches Claude may run in a single turn.
JARVIS_WEB_SEARCH_MAX_USES=5

# Optional: enables real URL reading (Anthropic's own server-side web_fetch
# tool — same account/billing as web_search above) so JARVIS can actually
# open and read a page's content, not just see a search snippet. Off by
# default.
JARVIS_WEB_FETCH=false

# Optional: caps how many URL fetches Claude may run in a single turn.
JARVIS_WEB_FETCH_MAX_USES=5

# Optional: live phone-call audio waveform on the dashboard, via Twilio
# Media Streams. Only meaningful when the phone gateway is configured.
# REAL EXTRA COST: Twilio bills Media Streams at ~$0.004/min on top of
# normal call minutes. Off by default.
JARVIS_AUDIO_WAVEFORM=false

# --- Optional: phone gateway (call JARVIS via Twilio) ---
# Both of the following must be set together, or neither. See README.md
# "Phone gateway (call JARVIS)" for full setup steps.

# Auth token from the Twilio console. Never commit the real value.
TWILIO_AUTH_TOKEN=

# The exact public HTTPS URL Twilio will call (e.g. https://jarvis-core.fly.dev
# or an ngrok URL). Required to verify Twilio's request signature.
TWILIO_PUBLIC_BASE_URL=

# Optional: comma-separated E.164 phone numbers allowed to call JARVIS
# (e.g. +15551234567,+15557654321). If unset, any caller reaches JARVIS —
# not recommended once the number is live.
TWILIO_ALLOWED_CALLERS=

# Optional: Twilio <Say> voice name. Defaults to "Polly.Matthew-Neural" (a
# natural-sounding neural voice available on standard Twilio accounts). See
# https://www.twilio.com/docs/voice/twiml/say/text-speech for other options,
# including newer (beta, opt-in) Generative voices if enabled on the account.
TWILIO_VOICE=

# Optional: Twilio <Say> voice for Hebrew replies. Defaults to
# "Google.he-IL-Wavenet-D" — Amazon Polly has no Hebrew voice at all, so
# Hebrew always goes through Twilio's Google TTS integration regardless of
# what TWILIO_VOICE above is set to.
TWILIO_VOICE_HEBREW=

# Optional: language Twilio's <Gather> recognizes speech in on phone calls.
# Defaults to "multi" — real automatic Hebrew/English detection via
# Twilio's deepgram_nova-3 speech model (a genuine Twilio feature, per
# their docs, but never exercised against a live account by this project).
# If deepgram_nova-3 isn't available on your Twilio account, set this to a
# single BCP-47 code instead (e.g. "he-IL" or "en-US") to fall back to
# Twilio's older single-language recognition.
TWILIO_GATHER_LANGUAGE=

# Optional: enables outbound calls (currently: scheduled wake-up calls) —
# all three required together. TWILIO_ACCOUNT_SID is your Twilio Account
# SID (from the Twilio console); TWILIO_FROM_NUMBER is the Twilio phone
# number to call FROM (E.164, e.g. +15005550006); JARVIS_OWNER_PHONE_NUMBER
# is your own phone number to call (E.164). Distinct from the inbound
# phone gateway above: a Twilio account can receive calls without ever
# placing one. Real Twilio per-minute cost applies to every call placed.
TWILIO_ACCOUNT_SID=
TWILIO_FROM_NUMBER=
JARVIS_OWNER_PHONE_NUMBER=

# Path to the SQLite database storing recurring wake-up/scheduled-call
# times (only meaningful when the outbound-call settings above are set).
JARVIS_WAKEUP_CALL_DB_PATH=./data/jarvis-wakeup-calls.sqlite

# Required once TWILIO_AUTH_TOKEN/TWILIO_PUBLIC_BASE_URL are set: a secret
# required (as the X-Jarvis-Admin-Token header) to call POST /pairing/approve.
# Without this, enabling the phone gateway also makes pairing approval
# reachable from the public internet with no protection beyond the pairing
# code itself — and that code is handed back to whoever requested it, so an
# attacker could register a fake device and immediately self-approve it. Set
# to any long random value, e.g. `openssl rand -hex 32`. Optional (but
# recommended) for purely local development with no phone gateway.
JARVIS_ADMIN_TOKEN=
