# Anthropic API key used by the Claude Brain. Never commit the real value.
ANTHROPIC_API_KEY=

# Port the JARVIS Core HTTP/WebSocket server listens on.
JARVIS_PORT=4770

# Path to the local SQLite memory database.
JARVIS_MEMORY_DB_PATH=./data/jarvis-memory.sqlite

# --- Optional: phone gateway (call JARVIS via Twilio) ---
# Both of the following must be set together, or neither. See README.md
# "Phone gateway (call JARVIS)" for full setup steps.

# Auth token from the Twilio console. Never commit the real value.
TWILIO_AUTH_TOKEN=

# The exact public HTTPS URL Twilio will call (e.g. https://jarvis-core.fly.dev
# or an ngrok URL). Required to verify Twilio's request signature.
TWILIO_PUBLIC_BASE_URL=

# Optional: comma-separated E.164 phone numbers allowed to call JARVIS
# (e.g. +15551234567,+15557654321). If unset, any caller reaches JARVIS —
# not recommended once the number is live.
TWILIO_ALLOWED_CALLERS=
